{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "homepage_url": "https://github.com/satomasahiro2005/ultimate-web-redactor",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_appName__"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "hide-selection": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "__MSG_cmdHide__"
    },
    "frame-selection": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_cmdFrame__"
    },
    "rect-mode": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_cmdRect__"
    },
    "pick-element": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "__MSG_cmdPick__"
    },
    "reveal-all": {
      "description": "__MSG_cmdReveal__"
    }
  }
}
